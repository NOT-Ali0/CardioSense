# Required in production: generate with `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace-with-64-char-random-hex-secret

# Flask environment: development | production
FLASK_ENV=production

# Set to 1 when behind HTTPS (production); set to 0 for local HTTP development
SESSION_COOKIE_SECURE=0

# Set to 1 when deployed behind a TLS-terminating reverse proxy (Nginx/Caddy/Render)
TRUST_PROXY=0

# Optional comma-separated allowed CORS origins (leave empty for same-origin only; never use *)
CORS_ORIGINS=

# Optional: Cohere API key (never commit real keys!)
COHERE_API_KEY=

# Optional one-time first admin bootstrap (only runs if zero admin users exist; remove password after first boot)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_NAME=System Administrator
# BOOTSTRAP_ADMIN_PASSWORD=

# Database connection URL (mapped to persistent container volume /app/instance)
DATABASE_URL=sqlite:////app/instance/cardiosense.db

# Rate limit storage backend (memory:// for single-worker Gunicorn; redis://host:6379/0 for multi-worker)
RATELIMIT_STORAGE_URI=memory://

# Server port
PORT=10000
